@startuml

|Security Guard (Actor)|
start
:Patrol Campus Parking Lot;

if (Illegal Parking Spotted?) then ([yes])
  :Report Severe Violation;

  |Parking Enforcement System|
  fork
    :Create Violation and Attach Fine to Owner Account;
  fork again
    :Notify User of Reported Violation;
  end fork

  |Student / User (Actor)|
  if (Submit Digital Appeal?) then ([yes])
    :Submit Appeal Reason and Evidence;

    |Traffic Administrator (Actor)|
    :Review Digital Appeal and Evidence;

    if (Appeal Approved?) then ([yes])
      |Parking Enforcement System|
      :Set AppealDecision to APPROVED;
      :Cancel Fine;

    else ([no])
      |Parking Enforcement System|
      :Set AppealDecision to REJECTED;
      :Enforce Fine;
    endif

    |Parking Enforcement System|
    :Archive Appeal Decision and Notify User;
    stop

  else ([no])
    |Parking Enforcement System|
    :Keep Fine Active and Block Permit Renewal;
    stop
  endif

else ([no])
  |Security Guard (Actor)|
  stop
endif

@enduml