@startuml
|Security Guard (Actor)|
start
:Patrol Campus Parking Lot;

if (Illegal Parking Spotted?) then ([yes])
  :Log Severe Violation on GuardTerminalUI;

  |EnforcementControl (System Controller)|
  fork
    :Create Violation and Attach Fine to Owner Account;
  fork again
    :Dispatch Violation Notification to User;
  end fork

  |Student / User (Actor)|
  if (Submit Digital Appeal?) then ([yes])
    :Submit Appeal Reason and Evidence via StudentDashboardUI;

    |Traffic Administrator (Actor)|
    :Review Digital Appeal and Evidence via AdminAppealUI;

    if (Appeal Approved?) then ([yes])
      |EnforcementControl (System Controller)|
      :Set AppealDecision to APPROVED and Cancel Fine;
    else ([no])
      |EnforcementControl (System Controller)|
      :Set AppealDecision to REJECTED and Enforce Fine;
    endif

    |EnforcementControl (System Controller)|
    :Archive Appeal Decision and Notify User;
    stop
  else ([no])
    |EnforcementControl (System Controller)|
    :Keep Fine Active and Block Permit Renewal;
    stop
  endif
else ([no])
  stop
endif

@enduml