@startuml

actor Student
boundary ":StudentDashboardUI" as UI
control ":ReservationControl" as Ctrl
entity "student : Student" as StudentEntity
entity "spot : ParkingSpot" as Spot
entity "res : Reservation" as Res
boundary ":LprGateBoundary" as LPR

Student -> UI : onReserveSpotClicked("EV-04", "12-345-67")
activate UI

UI -> Ctrl : reserveSpot(userId, "EV-04", "12-345-67")
activate Ctrl

Ctrl -> Spot : isAvailable()
activate Spot
Spot --> Ctrl : available
deactivate Spot

alt [available]
    Ctrl -> Spot : tryReserve(expectedVersion)
    activate Spot
    Spot --> Ctrl : acquired
    deactivate Spot

    alt [acquired]
        create Res
        Ctrl -> Res : <<create>>
        Ctrl --> UI : res
        UI -> UI : displayCountdown(15)

    else [reservationLost]
        note over Ctrl, Spot : Concurrent race condition
        Ctrl --> UI : null
        UI -> UI : showErrorAlert("Spot just reserved by another user")
    end

else [unavailable]
    Ctrl --> UI : null
    UI -> UI : showErrorAlert("Spot unavailable")
end

deactivate Ctrl
deactivate UI

== Within 15 Minutes: Vehicle Arrives at Entrance Gate ==

LPR -> Ctrl : processLprGateEntry("12-345-67", "EV Zone")
activate Ctrl

Ctrl -> Res : isWithin15MinWindow()
activate Res
Res --> Ctrl : valid
deactivate Res

alt [valid]
    Ctrl -> Res : setStatus(FULFILLED)
    activate Res
    deactivate Res

    Ctrl -> LPR : openBarrierGate()

else [expired]
    note over Ctrl, Res : No-Show: vehicle did not arrive within 15 minutes

    Ctrl -> Res : setStatus(NO_SHOW_REVOKED)
    activate Res
    deactivate Res

    Ctrl -> StudentEntity : incrementNoShowWarnings()
    activate StudentEntity
    deactivate StudentEntity

    destroy Res
    Ctrl -> LPR : denyEntry()
end

deactivate Ctrl
@enduml