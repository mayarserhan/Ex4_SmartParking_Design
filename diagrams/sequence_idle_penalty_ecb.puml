@startuml
participant ":IdlePenaltyScheduler" as Timer <<system>>
control ":EvBillingControl" as Billing
entity "session : ChargingSession" as Session
entity "fine : Violation" as Fine
boundary ":SmsGatewayBoundary" as SMS

Timer -> Billing : applyIdlePenalties()
activate Billing

loop for each completed ChargingSession
  Billing -> Session : isIdleOver30Minutes()
  activate Session
  Session --> Billing : overdue
  deactivate Session
  alt overdue == true (isPhysicallyOccupied == true)
    create Fine
    Billing -> Fine : <<create>> (5.0 NIS/hr)
    Billing -> SMS : sendSmsAlert(phoneNumber, "Idle penalty of 5 NIS/hr applied.")
  end
end

deactivate Billing
@enduml
