@startuml
left to right direction

' ==================================================
' ENUMERATIONS
' ==================================================
package "Enumerations" {
  together {
    enum UserRole {
      STUDENT
      FACULTY
      SECURITY_GUARD
      TRAFFIC_ADMIN
    }

    enum SpotStatus {
      AVAILABLE
      RESERVED
      OCCUPIED
    }

    enum ReservationStatus {
      ACTIVE
      FULFILLED
      NO_SHOW_REVOKED
    }

    enum AppealDecision {
      PENDING
      APPROVED
      REJECTED
    }
  }
}

' ==================================================
' BOUNDARY
' ==================================================
package "Boundary" {
  together {
    class StudentDashboardUI <<boundary>> {
      - selectedZone : String
      + displayAvailableSpots(spotIds : List<String>) : void
      + onReserveSpotClicked(spotId : String, licensePlate : String) : void
      + onSubmitAppealClicked(violationId : String, reasonText : String, evidenceRefs : List<String>) : void
      + displayCountdown(minutes : int) : void
      + showErrorAlert(message : String) : void
    }

    class GuardTerminalUI <<boundary>> {
      + onLogViolationClicked(licensePlate : String, reason : String) : void
      + onIssueGuestQrClicked(guestPlate : String) : void
    }

    class AdminAppealUI <<boundary>> {
      + onReviewAppealClicked(appealId : String, approved : boolean) : void
    }

    class LprGateBoundary <<boundary>> {
      + onPlateScanned(licensePlate : String, zoneName : String) : void
      + onGuestQrScanned(qrToken : String) : void
      + openBarrierGate() : void
      + denyEntry() : void
    }

    class PaymentGatewayBoundary <<boundary>> {
      + authorizeCreditCard(cardToken : String, amount : double) : String
    }

    class SmsGatewayBoundary <<boundary>> {
      + sendSmsAlert(phoneNumber : String, message : String) : void
    }
  }
}

' ==================================================
' CONTROL
' ==================================================
package "Control" {
  together {
    class ReservationControl <<control>> {
      - reservationWindowMin : int = 15
      + findAvailableSpots(userId : String, zoneId : String) : List<ParkingSpot>
      + reserveSpot(userId : String, spotId : String, licensePlate : String) : Reservation
      + processLprGateEntry(licensePlate : String, zoneName : String) : boolean
      + validateGuestQrEntry(qrToken : String) : boolean
      + revokeExpiredReservations() : void
    }

    class EvBillingControl <<control>> {
      - idleGraceMin : int = 30
      - idleRateNisPerHour : double = 5.0
      + authorizeEvPayment(reservationId : String, cardToken : String, amount : double) : PaymentAuthorization
      + notifyChargeComplete(sessionId : String) : void
      + applyIdlePenalties() : void
    }

    class EnforcementControl <<control>> {
      + issueGuestPass(guardId : String, guestPlate : String) : GuestPass
      + logSevereViolation(guardId : String, licensePlate : String, reason : String) : Violation
      + notifyUserOfViolation(violationId : String) : void
      + submitDigitalAppeal(violationId : String, reasonText : String, evidenceRefs : List<String>) : Appeal
      + reviewDigitalAppeal(adminId : String, appealId : String, approved : boolean) : void
    }
  }
}

' ==================================================
' ENTITY - USERS
' ==================================================
package "Entity - Users" {
  together {
    abstract class User <<entity>> {
      - userId : String
      - fullName : String
      - email : String
      - phoneNumber : String
      - role : UserRole
      - noShowWarnings : int
      + incrementNoShowWarnings() : void
    }

    class Student <<entity>> {
      - studentId : String
      - activePermit : boolean
      + hasActivePermit() : boolean
    }

    class Faculty <<entity>> {
      - facultyId : String
      - department : String
      - activePermit : boolean
      + hasActivePermit() : boolean
    }

    class SecurityGuard <<entity>> {
      - badgeNumber : String
    }

    class TrafficAdministrator <<entity>> {
      - adminOfficeId : String
    }
  }
}

' ==================================================
' ENTITY - PARKING & ACCESS
' ==================================================
package "Entity - Parking & Access" {
  together {
    class Vehicle <<entity>> {
      - licensePlate : String
    }

    class ParkingZone <<entity>> {
      - zoneId : String
      - zoneName : String
      - totalCapacity : int
    }

    class ParkingSpot <<entity>> {
      - spotId : String
      - isEvCharger : boolean
      - status : SpotStatus
      - version : int
      + isAvailable() : boolean
      + tryReserve(expectedVersion : int) : boolean
      + setStatus(status : SpotStatus) : void
    }

    class Reservation <<entity>> {
      - reservationId : String
      - createdAt : LocalDateTime
      - expiresAt : LocalDateTime
      - status : ReservationStatus
      + isWithin15MinWindow() : boolean
      + setStatus(status : ReservationStatus) : void
    }

    class GuestPass <<entity>> {
      - qrToken : String
      - guestPlate : String
      - expiresAt : LocalDateTime
      - isUsed : boolean
      + isValid() : boolean
      + markUsed() : void
    }
  }
}

' ==================================================
' ENTITY - EV CHARGING
' ==================================================
package "Entity - EV Charging" {
  together {
    class PaymentAuthorization <<entity>> {
      - authId : String
      - gatewayToken : String
      - authorizedAmount : double
      - authorizedAt : LocalDateTime
    }

    class ChargingSession <<entity>> {
      - sessionId : String
      - completedAt : LocalDateTime
      - completionNotifiedAt : LocalDateTime
      - isPluggedIn : boolean
      - isPhysicallyOccupied : boolean
      - idlePenaltyNis : double
      - lastPenaltyBilledAt : LocalDateTime
      + isIdleOver30Minutes() : boolean
      + isPhysicallyOccupied() : boolean
      + markCompletionNotified(sentAt : LocalDateTime) : void
      + handleUnpluggedCable() : void
    }
  }
}

' ==================================================
' ENTITY - ENFORCEMENT & APPEALS
' ==================================================
package "Entity - Enforcement & Appeals" {
  together {
    class Violation <<entity>> {
      - violationId : String
      - reason : String
      - fineAmount : double
      - isPaid : boolean
      - isCancelled : boolean
      + cancelFine() : void
    }

    class Appeal <<entity>> {
      - appealId : String
      - reasonText : String
      - evidenceRefs : List<String>
      - decision : AppealDecision
      + setDecision(decision : AppealDecision) : void
    }
  }
}

' ==================================================
' INHERITANCE
' ==================================================
User <|-- Student
User <|-- Faculty
User <|-- SecurityGuard
User <|-- TrafficAdministrator

' ==================================================
' AGGREGATION / COMPOSITION
' ==================================================
ParkingZone "1" o-- "1..*" ParkingSpot : contains
Reservation "1" *-- "0..1" PaymentAuthorization : EV authorization
Reservation "1" *-- "0..1" ChargingSession : initiates
Violation "1" *-- "0..1" Appeal : contested by

' ==================================================
' DOMAIN ASSOCIATIONS
' ==================================================
User "1" -- "0..*" Vehicle : owns
User "1" -- "0..*" Violation : billed for

Vehicle "1" -- "0..*" Reservation : booked for
ParkingSpot "1" -- "0..*" Reservation : assigned to
Vehicle "1" -- "0..*" Violation : involved in

SecurityGuard "0..1" -- "0..*" Violation : logs
SecurityGuard "1" -- "0..*" GuestPass : issues
TrafficAdministrator "0..1" -- "0..*" Appeal : reviews

ChargingSession "0..1" -- "0..*" Violation : incurs idle penalties

' ==================================================
' BOUNDARY -- CONTROL
' ==================================================
StudentDashboardUI -- ReservationControl : reservations
StudentDashboardUI -- EnforcementControl : appeals
GuardTerminalUI -- EnforcementControl : reports
AdminAppealUI -- EnforcementControl : decisions
LprGateBoundary -- ReservationControl : entry validation
PaymentGatewayBoundary -- EvBillingControl : payment auth
SmsGatewayBoundary -- EvBillingControl : charging alerts
SmsGatewayBoundary -- EnforcementControl : violation alerts

' ==================================================
' CONTROL -- ENTITY
' ==================================================
ReservationControl -- User : validates
ReservationControl -- Vehicle : identifies
ReservationControl -- ParkingZone : filters
ReservationControl -- ParkingSpot : reserves
ReservationControl -- Reservation : manages
ReservationControl -- GuestPass : validates

EvBillingControl -- PaymentAuthorization : manages
EvBillingControl -- ChargingSession : monitors
EvBillingControl -- Violation : creates idle penalties

EnforcementControl -- Vehicle : looks up
EnforcementControl -- GuestPass : issues
EnforcementControl -- Violation : manages
EnforcementControl -- Appeal : processes

@enduml